# ==============================================================================
# Deadline Guardian AI - Environment Configuration
# ==============================================================================

# Search Mode Configuration:
# Set MOCK_SEARCH_MODE=true to run without paid third-party search credentials.
MOCK_SEARCH_MODE=true

# Live Search Provider API Keys (Optional - only required if MOCK_SEARCH_MODE=false)
TAVILY_API_KEY=
SERPER_API_KEY=

# Fetch.ai uAgent Configuration (For Agentverse & ASI:One ACP integration)
AGENT_NAME=deadline_guardian_ai
AGENT_SEED=deadline_guardian_ai_fetchathon_2026_secret_seed_phrase
AGENT_PORT=8000

# Agentverse Mailbox Configuration (Format: <uuid>@https://agentverse.ai)
AGENTVERSE_MAILBOX_KEY=

LOG_LEVEL=INFO
